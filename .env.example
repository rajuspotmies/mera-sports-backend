# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# For local dev with docker-compose:
DATABASE_URL=postgresql://mutinyx:mutinyx_dev@localhost:5432/mutinyx
# On Railway: auto-injected from Postgres plugin

# ─── Redis ────────────────────────────────────────────────────────────────────
# For local dev with docker-compose:
REDIS_URL=redis://localhost:6379
# On Railway: auto-injected from Redis plugin

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_secure_32_char_min_secret_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Storage (Railway Buckets / S3) ───────────────────────────────────────────
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=mutiny-uploads

# Pick one: 'anthropic' | 'openai' | 'azure'
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# ─── Payments (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (Resend SMTP) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=notifications@mutinymaker.com

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Meta / Facebook (Instagram Connect) ─────────────────────────────────────
# From Meta for Developers → Your App → Settings → Basic
META_APP_ID=
META_APP_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
